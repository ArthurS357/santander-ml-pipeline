# ===========================================================================
# Variáveis de ambiente — Santander ML Pipeline (EXEMPLO)
#
# Copie para `.env` e preencha com valores reais. O `.env` é ignorado pelo
# Git (.gitignore); este `.env.example` é versionado APENAS com placeholders.
#   cp .env.example .env
#
# NUNCA commite segredos reais. Em produção, prefira um vault
# (HashiCorp Vault, AWS Secrets Manager) ou K8s Secrets.
# ===========================================================================

# --- Observabilidade: Grafana (docker-compose.observability.yml) -----------
# Credenciais de admin do Grafana. Sem .env, o compose usa fallback "admin".
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme

# --- API / Pipeline --------------------------------------------------------
# Connection string do banco de metadados. SQLite local (PoC) ou PostgreSQL.
#   PoC:        sqlite:///./training_history.db
#   Produção:   postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./training_history.db

# MLflow Tracking Server / store.
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db

# URI do modelo no MLflow Registry (vazio = carrega artefato local mais recente).
MODEL_URI=

# Token administrativo para POST /admin/reload_model.
# Vazio/ausente = endpoint nega acesso por padrão (fail-secure).
# Gerar: openssl rand -base64 32
ADMIN_RELOAD_TOKEN=

# --- Caminhos de dados -----------------------------------------------------
PROCESSED_DATA_FILE=data/processed/pima_diabetes_processed.csv
INFERENCE_LOG_FILE=data/logs/inference_logs.csv

# Threshold de drift (0.0 – 1.0).
DRIFT_THRESHOLD=0.5
